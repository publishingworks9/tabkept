{
  "manifest_version": 3,
  "name": "Tabkept: Session Saver & Tab Backup",
  "short_name": "Tabkept",
  "version": "1.0.0",
  "description": "Saves every window, tab and tab group as you work, keeps backup files you own, and restores them. Nothing leaves your computer.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Tabkept",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "downloads.ui",
    "offscreen",
    "contextMenus",
    "favicon"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open Tabkept"
    },
    "save-session": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save all windows as a session"
    },
    "sleep-others": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Sleep the other tabs in this window"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}